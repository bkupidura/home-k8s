global:
  timezone: "Europe/Warsaw"
  dns:
    servers:
    - "10.0.100.1"
os:
  cpu_governor: performance
  ssh_keys:
    - user: root
      key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC8yktF6/N1ho0QYQX0uFT9EX2fv6VCJyz58o3knrpIu bartosz@banshee.local"
    - user: ansible
      key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC8yktF6/N1ho0QYQX0uFT9EX2fv6VCJyz58o3knrpIu bartosz@banshee.local"
k3s:
  version: "v1.36.4+k3s1"
  cni_url: "https://github.com/containernetworking/plugins/releases/download/v1.9.1/cni-plugins-linux-amd64-v1.9.1.tgz"
  service:
    create:
      custom-cni-dhcp:
        wants: network-online.target
        after: network.service
        exec_start: /opt/cni/bin/dhcp daemon
        wanted_by: default.target
  args:
    - "--disable"
    - "traefik"
    - "--disable"
    - "servicelb"
    - "--disable"
    - "coredns"
    - "--disable"
    - "local-storage"
    - "--flannel-backend"
    - "none"
    - "--disable-network-policy"
    - "--kube-apiserver-arg"
    - "default-unreachable-toleration-seconds=120"
    - "--kube-apiserver-arg"
    - "default-not-ready-toleration-seconds=120"
    - "--kubelet-arg"
    - "image-gc-high-threshold=60"
    - "--kubelet-arg"
    - "image-gc-low-threshold=50"
    - "--kubelet-arg"
    - "node-status-max-images=-1"
    - "--secrets-encryption"
cilium:
  cli_version: "v0.20.0"
  version: "1.20.1"
  pod_cidr: "10.42.0.0/16"
  bgp:
    local_asn: 64500
    peer_asn: 64501
    peer_address: "10.0.100.1"
  lb_pool: "10.0.10.0/24"
  vlan_bpf_bypass:
    - 100
    - 200
