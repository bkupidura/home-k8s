$ModLoad imudp
$RuleSet remote

{% set local_ip = hostvars[inventory_hostname].ansible_facts[os.primary_interface].ipv4.address %}
{% for host in hostvars %}
{% if host != 'localhost' %}
{%- set remote_ip = hostvars[host].ansible_facts[hostvars[host].os.primary_interface].ipv4.address %}
{%- set remote_hostname = hostvars[host].ansible_facts.hostname %}
{%- if remote_ip != local_ip %}
if $fromhost-ip=='{{ remote_ip }}' then /var/log/{{ remote_hostname }}-console.log
& stop
{% endif %}
{% endif %}
{% endfor %}

$InputUDPServerBindRuleset remote
$UDPServerRun 6666

$RuleSet RSYSLOG_DefaultRuleset
